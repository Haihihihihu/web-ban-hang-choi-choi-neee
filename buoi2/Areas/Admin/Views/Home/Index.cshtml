</main>

<footer class="site-footer">
    <section class="footer-categories-section" id="footer-categories">
        <div class="shop-container">
            <h2 class="section-title footer-section-title">Danh mục sản phẩm</h2>
            @if (Model.Categories != null && Model.Categories.Any())
            {
                <div class="categories-grid">
                    @foreach (var category in Model.Categories)
                    {
                        <div class="category-card">
                            <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@category.Id" class="category-link">
                                <div class="category-image-container">
                                    <img src="@(category.ImageUrl ?? "/images/default-category.jpg")" class="category-image" alt="@category.Name">
                                </div>
                                <div class="category-info">
                                    <h3 class="category-name">@category.Name</h3>
                                </div>
                            </a>
                        </div>
                    }
                </div>
                <div class="text-center mb-4">
                    <a asp-controller="Product" asp-action="Index" class="btn btn-light btn-lg rounded-pill">
                        Xem tất cả sản phẩm
                    </a>
                </div>
            }
            else
            {
                <div class="no-categories text-center">
                    <i class="fas fa-box-open mb-3" style="font-size: 48px; color: #ccc;"></i>
                    <p>Không có danh mục nào được tìm thấy.</p>
                </div>
            }
        </div>
    </section>

</footer>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        let currentSlide = 0;
        const slides = document.querySelectorAll('.slide');
        const totalSlides = slides.length;

        function showSlide(index) {
            slides.forEach((slide, i) => {
                slide.classList.remove('active');
                if (i === index) {
                    slide.classList.add('active');
                }
            });
        }

        function nextSlide() {
            currentSlide = (currentSlide + 1) % totalSlides;
            showSlide(currentSlide);
        }

        // Khởi tạo slider và chạy tự động
        if (totalSlides > 0) {
            showSlide(currentSlide); // Hiển thị slide đầu tiên khi tải trang
            setInterval(nextSlide, 4000);
        }

        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });
    });
</script>