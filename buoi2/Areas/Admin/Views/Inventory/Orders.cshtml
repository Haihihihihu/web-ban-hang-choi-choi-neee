@model IEnumerable<buoi2.Models.Order>
@{
    ViewData["Title"] = "Manage Orders";
}
<h1>Inventory - Orders</h1>

@if (TempData["Message"] != null)
{
    <div class="alert alert-info">@TempData["Message"]</div>
}

<table class="table table-bordered mt-3">
    <thead>
        <tr>
            <th>Order ID</th>
            <th>User ID</th>
            <th>Status</th>
            <th>Total Price</th>
            <th>Order Date</th>
            <th>Items (Product - Quantity)</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>@order.Id</td>
                <td>@order.UserId</td>
                <td>@order.Status</td>
                <td>@order.TotalPrice.ToString("c")</td>
                <td>@order.OrderDate</td>
                <td>
                    @foreach (var d in order.OrderDetails)
                    {
                        <span>@d.ProductId - @d.Quantity</span>

                        <br />
                    }
                </td>
                <td>
                    @if (order.Status != buoi2.Models.Order.OrderStatus.Cancelled)
                    {
                        <form asp-action="CancelOrder" method="post" onsubmit="return confirm('Cancel this order?');">
                            <input type="hidden" name="orderId" value="@order.Id" />
                            <button class="btn btn-danger btn-sm" type="submit">Cancel</button>
                        </form>
                    }
                    else
                    {
                        <span class="text-muted">Cancelled</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
