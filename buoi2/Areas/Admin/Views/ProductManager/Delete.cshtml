@model buoi2.Models.Product

<div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="card shadow-lg border-0 p-5" style="max-width: 600px; width: 100%;">
        <div class="text-center">
            <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 3rem;"></i>
            <h2 class="mt-3 mb-4 text-danger">Xóa sản phẩm</h2>
            <p class="fs-5">
                Bạn có chắc chắn muốn xóa sản phẩm
                <strong class="text-dark">@Model.Name</strong>?
            </p>
        </div>

        <form asp-action="DeleteConfirmed" method="post" asp-antiforgery="true">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div class="d-flex justify-content-center mt-4 gap-3">
                <button type="submit" class="btn btn-danger px-4 py-2 shadow-sm">   
                    <i class="bi bi-trash3 me-1"></i> Xóa
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2 shadow-sm">
                    <i class="bi bi-x-lg me-1"></i> Hủy
                </a>
            </div>
        </form>
    </div>
</div>
