@model IEnumerable<buoi2.Models.Product>

@{

    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Index";
    string currentSearch = ViewBag.SearchName as string ?? "";
    string currentSort = ViewBag.SortBy as string ?? "";
    Layout = "~/Admin/Views/Shared/_Layout.cshtml";
    

}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<style>
    body {
        background: linear-gradient(135deg, #f9fafb 0%, #e5e7eb 100%); /* Giữ nguyên gradient trắng xám nhẹ */
    }

    /* Product List Header */
    .product-list-header {
        font-size: 2.25rem; /* Slightly larger header */
        margin-bottom: 2.5rem;
        color: #1e293b; /* Xám đậm hơn, dễ đọc */
        font-weight: 700;
        letter-spacing: 0.5px;
        text-align: center;
        text-shadow: 0 2px 6px rgba(0, 0, 0, 0.2); /* Shadow đậm hơn */
        transition: opacity 0.3s ease; /* Smooth opacity transition */
    }

        .product-list-header:hover {
            opacity: 0.7; /* Fade effect on hover */
        }

    /* Card Styling */
    .card {
        border: 1px solid rgba(107, 114, 128, 0.5); /* Xám trung bình cho viền */
        border-radius: 1rem;
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.2); /* Shadow đậm hơn */
        background: #ffffff; /* Trắng thuần */
        margin: 0 auto 2.5rem;
        max-width: 1400px; /* Increased width to prevent button wrap */
    }

    /* Card Body */
    .card-body {
        padding: 2.5rem; /* Increased padding */
    }

    /* Button Styling */
    .btn {
        display: inline-block;
        padding: 0.75rem 1.75rem; /* Slightly larger buttons */
        border-radius: 8px;
        text-decoration: none;
        font-size: 1rem;
        font-weight: 700; /* Tăng đậm cho chữ nút */
        transition: all 0.3s ease;
        border: 1px solid transparent;
        white-space: nowrap; /* Prevent text wrap */
    }

    .btn-primary {
        background: linear-gradient(90deg, #4b5563, #1e293b); /* Gradient xám đậm */
        color: #ffffff;
        border: 1px solid rgba(30, 41, 59, 0.7); /* Viền đậm hơn */
    }

        .btn-primary:hover {
            background: linear-gradient(90deg, #1e293b, #111827); /* Gradient xám rất đậm */
            box-shadow: 0 0 15px rgba(30, 41, 59, 0.6); /* Shadow đậm hơn */
            transform: translateY(-2px);
        }

    .btn-outline-info {
        border: 1px solid #3b82f6; /* Xanh dương đậm */
        color: #3b82f6;
    }

        .btn-outline-info:hover {
            background-color: #3b82f6;
            color: #ffffff;
            box-shadow: 0 0 12px rgba(59, 130, 246, 0.5);
        }

    .btn-outline-warning {
        border: 1px solid #f59e0b; /* Vàng cam đậm */
        color: #f59e0b;
    }

        .btn-outline-warning:hover {
            background-color: #f59e0b;
            color: #ffffff;
            box-shadow: 0 0 12px rgba(245, 158, 11, 0.5);
        }

    .btn-outline-danger {
        border: 1px solid #dc2626; /* Đỏ đậm */
        color: #dc2626;
    }

        .btn-outline-danger:hover {
            background-color: #dc2626;
            color: #ffffff;
            box-shadow: 0 0 12px rgba(220, 38, 38, 0.5);
        }

    /* Table Container */
    .table-container {
        overflow-x: auto;
    }

    /* Product Table */
    .product-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 1rem;
        color: #1e293b; /* Xám đậm hơn cho chữ */
    }

        .product-table th,
        .product-table td {
            padding: 1rem 1rem; /* Reduced padding to fit more content */
            text-align: left;
            vertical-align: middle;
            border: 1px solid rgba(107, 114, 128, 0.3); /* Xám trung bình với transparency */
        }

        .product-table th {
            background: linear-gradient(90deg, #6b7280, #4b5563); /* Gradient xám đậm */
            color: #ffffff; /* Trắng cho header */
            font-weight: 700; /* Tăng đậm */
            letter-spacing: 0.5px;
        }

        .product-table tr {
            background-color: #ffffff; /* Trắng thuần */
            transition: background-color 0.3s ease;
        }

            .product-table tr:hover {
                background-color: #f3f4f6; /* Xám nhạt hơn khi hover */
            }

        .product-table .text-center {
            text-align: center;
            color: #6b7280; /* Xám trung bình cho trạng thái trống */
        }

    /* Product Image */
    .product-image {
        max-width: 120px;
        max-height: 120px;
        object-fit: cover;
        border-radius: 8px;
        border: 1px solid rgba(107, 114, 128, 0.5); /* Xám trung bình cho viền */
        transition: transform 0.3s ease;
    }

        .product-image:hover {
            transform: scale(1.05); /* Slight zoom on hover */
        }

    /* Text Muted */
    .text-muted {
        color: #6b7280; /* Xám trung bình */
    }
</style>

<h2 class="product-list-header">Danh Sách Sản Phẩm</h2>

<div class="card">
    <div class="card-body">
        <a href="@Url.Action("Add")" class="btn btn-primary">Add New Product</a>
        <br />
        <div class="table-container">
            <table class="product-table" aria-label="Product list">
                <thead>
                    <tr>
                        <th scope="col">Name</th>
                        <th scope="col">Price</th>
                        <th scope="col">Description</th>
                        <th scope="col">Category</th>
                        <th scope="col">Image</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted">No products available.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var product in Model)
                        {
                            <tr>
                                <td>@product.Name</td>
                        @using System.Globalization

                                <td>@product.Price.ToString("C", new CultureInfo("vi-VN"))</td>
                                <td>@(string.IsNullOrEmpty(product.Description) ? "N/A" : product.Description)</td>
                                <td>@(product.Category?.Name ?? "N/A")</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(product.ImageUrl))
                                    {
                                        <img src="@product.ImageUrl" alt="@product.Name" class="product-image" />
                                    }
                                    else
                                    {
                                        <span class="text-muted">No image</span>
                                    }
                                </td>
                                <td>
                                    <a href="@Url.Action("Display", new { id = product.Id })" class="btn btn-outline-info">View</a>
                                    <a href="@Url.Action("Update", new { id = product.Id })" class="btn btn-outline-warning">Edit</a>
                                    <a href="@Url.Action("Delete", new { id = product.Id })" class="btn btn-outline-danger">Delete</a>
                                </td>
                            </tr>

                            <a asp-area="Admin" asp-action="Update" asp-route-id="@product.Id" class="btn btn-sm btn-outline-success custom-btn">Edit</a>
                            <a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-sm btn-outline-danger custom-btn"
                               onclick="return confirm('Are you sure you want to delete this product?');">Delete</a>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}