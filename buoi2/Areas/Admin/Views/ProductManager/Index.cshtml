@model IEnumerable<buoi2.Models.Product>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Danh Sách Sản Phẩm";
    string currentSearch = ViewBag.SearchName as string ?? "";
    string currentSort = ViewBag.SortBy as string ?? "";
}

<style>
    body {
        background: linear-gradient(135deg, #f9fafb 0%, #e5e7eb 100%);
    }

    .product-list-header {
        font-size: 2.25rem;
        margin-bottom: 2.5rem;
        color: #1e293b;
        font-weight: 700;
        letter-spacing: 0.5px;
        text-align: center;
        text-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
        transition: opacity 0.3s ease;
    }

        .product-list-header:hover {
            opacity: 0.7;
        }

    .card {
        border-radius: 1rem;
        box-shadow: 0 12px 30px rgba(0,0,0,0.12);
        margin: 0 auto 2.5rem;
        max-width: 1400px;
    }

    .card-body {
        padding: 2.5rem;
    }

    .btn {
        padding: 0.5rem 1.5rem;
        border-radius: 8px;
        font-weight: 700;
        transition: all 0.3s;
    }

    .btn-primary {
        background: linear-gradient(90deg, #4b5563, #1e293b);
        color: #fff;
        border: none;
    }

        .btn-primary:hover {
            background: linear-gradient(90deg, #1e293b, #111827);
        }

    .btn-outline-info {
        border: 1px solid #3b82f6;
        color: #3b82f6;
    }

        .btn-outline-info:hover {
            background: #3b82f6;
            color: #fff;
        }

    .btn-outline-warning {
        border: 1px solid #f59e0b;
        color: #f59e0b;
    }

        .btn-outline-warning:hover {
            background: #f59e0b;
            color: #fff;
        }

    .btn-outline-danger {
        border: 1px solid #dc2626;
        color: #dc2626;
    }

        .btn-outline-danger:hover {
            background: #dc2626;
            color: #fff;
        }

    .table-container {
        overflow-x: auto;
    }

    .product-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 1rem;
        color: #1e293b;
    }

        .product-table th, .product-table td {
            padding: 1rem;
            text-align: left;
            border: 1px solid #e5e7eb;
        }

        .product-table th {
            background: linear-gradient(90deg, #6b7280, #4b5563);
            color: #fff;
            font-weight: 700;
        }

        .product-table tr {
            background-color: #fff;
            transition: background 0.3s;
        }

            .product-table tr:hover {
                background: #f3f4f6;
            }

    .product-image {
        max-width: 100px;
        max-height: 100px;
        object-fit: cover;
        border-radius: 8px;
        border: 1px solid #e5e7eb;
    }

    .text-muted {
        color: #6b7280;
    }
</style>

<h2 class="product-list-header">Danh Sách Sản Phẩm</h2>

<div class="card">
    <div class="card-body">
        <a href="@Url.Action("Add")" class="btn btn-primary mb-3">Thêm sản phẩm mới</a>
        <div class="table-container">
            <table class="product-table" aria-label="Product list">
                <thead>
                    <tr>
                        <th>Tên</th>
                        <th>Giá</th>
                        <th>Mô tả</th>
                        <th>Danh mục</th>
                        <th>Hình ảnh</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted">Không có sản phẩm nào.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var product in Model)
                        {
                            <tr>
                                <td>@product.Name</td>
                                <td>@product.Price.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))</td>
                                <td>@(string.IsNullOrEmpty(product.Description) ? "N/A" : product.Description)</td>
                                <td>@(product.Category?.Name ?? "N/A")</td>
                                <td>
                                    @{
                                        string adminProductImageUrl = "";
                                        if (product.Images != null && product.Images.Any() && !string.IsNullOrEmpty(product.Images.First().Url))
                                        {
                                            adminProductImageUrl = product.Images.First().Url;
                                        }
                                        else if (!string.IsNullOrEmpty(product.ImageUrl))
                                        {
                                            adminProductImageUrl = product.ImageUrl;
                                        }
                                    }
                                    @if (!string.IsNullOrEmpty(adminProductImageUrl))
                                    {
                                        <img src="@adminProductImageUrl" alt="@product.Name" class="product-image" />
                                    }
                                    else
                                    {
                                        <span class="text-muted">Không có ảnh</span>
                                    }
                                </td>
                                <td>
                                    <a href="@Url.Action("Display", new { id = product.Id })" class="btn btn-outline-info btn-sm">Xem</a>
                                    <a href="@Url.Action("Update", new { id = product.Id })" class="btn btn-outline-warning btn-sm">Sửa</a>
                                    <a href="@Url.Action("Delete", new { id = product.Id })" class="btn btn-outline-danger btn-sm"
                                       onclick="return confirm('Bạn có chắc chắn muốn xóa sản phẩm này?');">Xóa</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}