@model IEnumerable<buoi2.Models.Product>
@using System.Linq
@using System.Globalization

@{
    Layout = "/Views/Shared/_Layout.cshtml";
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<style>
    body {
        background: linear-gradient(135deg, #f9fafb 0%, #e5e7eb 100%);
    }

    .product-list-header {
        font-size: 2.25rem;
        margin-bottom: 2.5rem;
        color: #1e293b;
        font-weight: 700;
        letter-spacing: 0.5px;
        text-align: center;
        text-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
        transition: opacity 0.3s ease;
    }

        .product-list-header:hover {
            opacity: 0.7;
        }

    .card {
        border: 1px solid rgba(107, 114, 128, 0.5);
        border-radius: 1rem;
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.2);
        background: #fff;
        margin: 0 auto 2.5rem;
        max-width: 1400px;
    }

    .card-body {
        padding: 2.5rem;
    }

    .btn {
        padding: 0.75rem 1.75rem;
        border-radius: 8px;
        font-weight: 700;
        white-space: nowrap;
    }

    .btn-primary {
        background: linear-gradient(90deg, #4b5563, #1e293b);
        color: #fff;
        border: 1px solid rgba(30, 41, 59, 0.7);
    }

        .btn-primary:hover {
            background: linear-gradient(90deg, #1e293b, #111827);
            box-shadow: 0 0 15px rgba(30, 41, 59, 0.6);
            transform: translateY(-2px);
        }

    .btn-outline-info {
        border: 1px solid #3b82f6;
        color: #3b82f6;
    }

        .btn-outline-info:hover {
            background: #3b82f6;
            color: #fff;
            box-shadow: 0 0 12px rgba(59,130,246,0.5);
        }

    .btn-outline-warning {
        border: 1px solid #f59e0b;
        color: #f59e0b;
    }

        .btn-outline-warning:hover {
            background: #f59e0b;
            color: #fff;
            box-shadow: 0 0 12px rgba(245,158,11,0.5);
        }

    .btn-outline-danger {
        border: 1px solid #dc2626;
        color: #dc2626;
    }

        .btn-outline-danger:hover {
            background: #dc2626;
            color: #fff;
            box-shadow: 0 0 12px rgba(220,38,38,0.5);
        }

    .table-container {
        overflow-x: auto;
    }

    .product-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 1rem;
        color: #1e293b;
    }

        .product-table th, .product-table td {
            padding: 1rem;
            border: 1px solid rgba(107,114,128,0.3);
            vertical-align: middle;
        }

        .product-table th {
            background: linear-gradient(90deg, #6b7280, #4b5563);
            color: #fff;
            font-weight: 700;
            letter-spacing: 0.5px;
        }

        .product-table tr {
            background: #fff;
            transition: background-color 0.3s ease;
        }

            .product-table tr:hover {
                background: #f3f4f6;
            }

    .text-center {
        text-align: center;
        color: #6b7280;
    }

    .product-image {
        max-width: 120px;
        max-height: 120px;
        object-fit: cover;
        border-radius: 8px;
        border: 1px solid rgba(107,114,128,0.5);
        transition: transform 0.3s ease;
    }

        .product-image:hover {
            transform: scale(1.05);
        }

    .text-muted {
        color: #6b7280;
    }
</style>

<h2 class="product-list-header">Danh Sách Sản Phẩm</h2>

<div class="card">
    <div class="card-body">
        <a href="@Url.Action("Add")" class="btn btn-primary">Add New Product</a>
        <br />
        <div class="table-container">
            <table class="product-table" aria-label="Product list">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Price</th>
                        <th>Description</th>
                        <th>Category</th>
                        <th>Image</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted">No products available.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var product in Model)
                        {
                            <tr>
                                <td>@product.Name</td>
                                <td>@product.Price.ToString("C", new CultureInfo("vi-VN"))</td>
                                <td>@(string.IsNullOrEmpty(product.Description) ? "N/A" : product.Description)</td>
                                <td>@(product.Category?.Name ?? "N/A")</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(product.ImageUrl))
                                    {
                                        <img src="@product.ImageUrl" alt="@product.Name" class="product-image" />
                                    }
                                    else
                                    {
                                        <span class="text-muted">No image</span>
                                    }
                                </td>
                                <td>
                                    <a href="@Url.Action("Display", new { id = product.Id })" class="btn btn-outline-info">View</a>
                                    <a href="@Url.Action("Update", new { id = product.Id })" class="btn btn-outline-warning">Edit</a>
                                    <a href="@Url.Action("Delete", new { id = product.Id })" class="btn btn-outline-danger"
                                       onclick="return confirm('Bạn chắc chắn muốn xóa sản phẩm này?');">Delete</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
