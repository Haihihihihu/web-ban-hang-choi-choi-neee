@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<style>
    body {
        background: linear-gradient(135deg, #f8fafc 0%, #e0e7ef 100%);
        min-height: 100vh;
        margin: 0;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }
    .forgot-container {
        background: #fff;
        border-radius: 18px;
        box-shadow: 0 8px 32px rgba(0,0,0,0.08);
        max-width: 420px;
        margin: 60px auto;
        padding: 40px 32px 32px 32px;
        position: relative;
    }
    .forgot-container h1 {
        font-size: 2rem;
        font-weight: 700;
        color: #0d6efd;
        margin-bottom: 8px;
        text-align: center;
    }
    .forgot-container h2 {
        font-size: 1.1rem;
        color: #555;
        text-align: center;
        margin-bottom: 24px;
        font-weight: 400;
    }
    .forgot-container hr {
        margin: 18px 0 28px 0;
        border-top: 1px solid #eee;
    }
    .form-floating > .form-control {
        height: 54px;
        font-size: 1.1rem;
        border-radius: 10px;
    }
    .btn-submit {
        background: linear-gradient(90deg, #0d6efd 0%, #2563eb 100%);
        color: #fff;
        font-weight: 600;
        border: none;
        padding: 14px;
        border-radius: 10px;
        width: 100%;
        margin-top: 18px;
        font-size: 1.1rem;
        box-shadow: 0 2px 8px rgba(13,110,253,0.08);
        transition: background 0.2s;
    }
    .btn-submit:hover {
        background: linear-gradient(90deg, #2563eb 0%, #0d6efd 100%);
    }
    .alert-info, .text-danger {
        margin-top: 18px;
        font-size: 1rem;
        border-radius: 8px;
    }
    .text-danger {
        color: #dc3545 !important;
    }
  
</style>
<div class="forgot-container">
    <h1><i class="fas fa-unlock-alt me-2"></i>@ViewData["Title"]</h1>
    <h2>Nhập email để lấy lại mật khẩu</h2>
    <hr />
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <div class="form-floating mb-3">
            <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
            <label asp-for="Input.Email">Email</label>
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>
        <button type="submit" class="btn-submit"><i class="fas fa-paper-plane me-2"></i>Gửi yêu cầu đặt lại mật khẩu</button>
    </form>
    <div class="text-center mt-4">
        <a href="/Identity/Account/Login" class="text-decoration-underline"><i class="fas fa-arrow-left me-1"></i>Quay lại đăng nhập</a>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
