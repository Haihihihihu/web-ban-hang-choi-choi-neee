@model IEnumerable<buoi2.Models.Product>
@{
    ViewData["Title"] = "Home Page";
    int numOfQuantity = 1; // Assuming this is still needed for AddToCart action
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<style>
    /* Styles from the Product Listing (Index) Page */
    body {
        background-color: #ffffff;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .shop-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 20px;
        background-color: #ffffff;
    }

    .products-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 30px;
        margin-bottom: 50px;
    }

    .product-card {
        background-color: #ffffff;
        border: 1px solid #e8e8e8;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

        .product-card:hover {
            box-shadow: 0 8px 25px rgba(0,0,0,0.1);
            transform: translateY(-2px);
        }

    .product-image-container {
        position: relative;
        width: 100%;
        height: 350px;
        overflow: hidden;
        background-color: #f8f9fa;
    }

    .product-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .product-card:hover .product-image {
        transform: scale(1.05);
    }

    .new-arrival-badge {
        position: absolute;
        top: 10px;
        left: 10px;
        background-color: #333;
        color: white;
        padding: 5px 12px;
        font-size: 11px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .product-info {
        padding: 20px;
        text-align: center;
    }

    .product-name {
        font-size: 14px;
        font-weight: 400;
        color: #333;
        margin: 0 0 8px 0;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        line-height: 1.4;
    }

    .product-description {
        font-size: 13px;
        color: #666;
        margin: 0 0 12px 0;
        line-height: 1.4;
        height: 35px;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    .product-price {
        font-size: 16px;
        color: #333;
        font-weight: 600;
        margin: 0 0 20px 0;
    }

    .product-actions {
        display: flex;
        justify-content: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .action-btn {
        padding: 8px 16px;
        font-size: 12px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border: 1px solid #333;
        background-color: transparent;
        color: #333;
        text-decoration: none;
        transition: all 0.3s ease;
        min-width: 70px;
    }

        .action-btn:hover {
            background-color: #333;
            color: white;
            text-decoration: none;
        }

        .action-btn.btn-view {
            border-color: #007bff;
            color: #007bff;
        }

            .action-btn.btn-view:hover {
                background-color: #007bff;
                color: white;
            }

    .banner-slider {
        height: 400px;
        position: relative;
        overflow: hidden;
        margin: 2rem auto;
        max-width: 1400px;
        border-radius: 0;
        box-shadow: none;
    }

    .slide {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        transition: opacity 1s ease-in-out;
        background-size: cover;
        background-position: center;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .slide.active {
            opacity: 1;
        }

    .slide-content {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        padding: 3rem;
        border-radius: 0;
        text-align: center;
        transform: translateY(20px);
        animation: slideUp 0.8s ease-out forwards;
        box-shadow: none;
    }

    @@keyframes slideUp {
        to {
            transform: translateY(0);
        }
    }

    .slide-title {
        font-size: 2.5rem;
        font-weight: 300;
        color: #333;
        margin: 0;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    .slide-subtitle {
        font-size: 1rem;
        color: #666;
        margin-bottom: 1.5rem;
    }

    .slide-btn {
        background-color: #333;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 0;
        font-size: 14px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 1px;
        cursor: pointer;
        transition: background-color 0.3s ease;
        text-decoration: none;
        display: inline-block;
        box-shadow: none;
    }

        .slide-btn:hover {
            background-color: #000;
            transform: none;
            box-shadow: none;
            color: white;
        }

    .main-content {
        min-height: 60vh;
        padding: 3rem 0;
    }

    .welcome-section {
        text-align: center;
        padding: 4rem 0;
    }

    .welcome-title {
        font-size: 2.5rem;
        font-weight: 300;
        color: #333;
        margin: 0;
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-bottom: 2rem;
    }

    .welcome-subtitle {
        font-size: 1.1rem;
        color: #666;
        max-width: 600px;
        margin: 0 auto;
    }

    .site-footer {
        background-color: #333;
        color: white;
        margin-top: 5rem;
        position: relative;
        overflow: hidden;
    }

        .site-footer::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent);
        }

    .footer-products-section {
        padding: 4rem 0;
        background: #f8f9fa;
    }

    .section-title {
        text-align: center;
        font-size: 2.5rem;
        font-weight: 300;
        color: #333;
        margin-bottom: 3rem;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    .footer-section-title {
        background: none;
        -webkit-background-clip: unset;
        -webkit-text-fill-color: unset;
        background-clip: unset;
        color: #333;
    }

    .footer-info {
        padding: 3rem 0 2rem;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        text-align: center;
    }

        .footer-info p {
            margin: 0;
            color: rgba(255, 255, 255, 0.8);
            font-size: 0.9rem;
        }

    @@media (max-width: 768px) {
        .slide-title, .welcome-title, .section-title {
            font-size: 2rem;
        }

        .slide-content {
            padding: 2rem;
        }

        .banner-slider {
            height: 300px;
        }

        .welcome-section {
            padding: 2rem 0;
        }

        .footer-products-section {
            padding: 2rem 0;
        }
    }
</style>

<div class="banner-slider">
    <div class="slide active" style="background-image: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)), url('https://images.unsplash.com/photo-1441986300917-64674bd600d8?...');">
        <div class="slide-content">
            <h2 class="slide-title">Thời trang cao cấp</h2>
            <p class="slide-subtitle">Phong cách đẳng cấp cho bạn</p>
            <a href="#footer-products" class="slide-btn">Xem thêm</a>
        </div>
    </div>
</div>

<main class="main-content">
    <section class="welcome-section">
        <div class="container">
            <h1 class="welcome-title">Chào mừng đến với cửa hàng</h1>
            <p class="welcome-subtitle">
                Khám phá bộ sưu tập thời trang độc đáo và chất lượng cao.
                Chúng tôi mang đến cho bạn những sản phẩm tốt nhất với giá cả hợp lý.
            </p>
        </div>
    </section>
</main>

<footer class="site-footer">
    <section class="footer-products-section" id="footer-products">
        <div class="shop-container">
            <h2 class="section-title footer-section-title">Sản phẩm nổi bật</h2>
            @if (Model != null && Model.Any())
            {
                <div class="products-grid">
                    @foreach (var product in Model)

            <div class="text-center mb-4">
                <a asp-controller="Product" asp-action="Index" class="btn btn-light btn-lg rounded-pill">
                    Xem tất cả sản phẩm
                </a>
            </div>
            <div class="px-4 px-lg-5">
                <div class="row gx-4 gx-lg-5 row-cols-2 row-cols-md-3 row-cols-xl-4 justify-content-center">
                    @foreach (var item in Model)
                    {
                        <div class="product-card">
                            <div class="product-image-container">
                                <img src="@(product.ImageUrl ?? "/images/default-product.jpg")" class="product-image" alt="@product.Name">
                                <div class="new-arrival-badge">Hot</div>
                            </div>
                            <div class="product-info">
                                <h3 class="product-name">@product.Name</h3>
                                <p class="product-description">@product.Description</p>
                                <div class="product-price">$@product.Price</div>
                                <div class="product-actions">
                                    <a asp-action="Display" asp-route-id="@product.Id" class="action-btn btn-view">View</a>
                                    <a asp-controller="ShoppingCart" asp-action="AddToCart"
                                       asp-route-productId="@product.Id" asp-route-quantity="@numOfQuantity"
                                       class="action-btn">
                                        <i class="bi bi-cart-fill me-2"></i>Add to Cart
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="no-products">
                    <i class="fas fa-search mb-3" style="font-size: 48px; color: #ccc;"></i>
                    <p>No products found matching your criteria.</p>
                </div>
            }
        </div>
    </section>
</footer>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        let currentSlide = 0;
        const slides = document.querySelectorAll('.slide');
        const totalSlides = slides.length;

        function showSlide(index) {
            slides.forEach((slide, i) => {
                slide.classList.remove('active');
                if (i === index) {
                    slide.classList.add('active');
                }
            });
        }

        function nextSlide() {
            currentSlide = (currentSlide + 1) % totalSlides;
            showSlide(currentSlide);
        }

        setInterval(nextSlide, 4000);

        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });
    });
</script>
