@model buoi2.Models.Product
@{
    ViewData["Title"] = "Display";
}

<!-- Add Font Awesome for icons -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<div class="container mt-5">
    <h2 class="text-center mb-4" style="color: #4a00e0;">
        <i class="fas fa-box-open me-2"></i>Product Details
    </h2>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-body">
                    <!-- Product Information -->
                    <div class="row">
                        <!-- Images Section -->
                        <div class="col-md-6">
                            <!-- Main Image -->
                            @if (!string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid rounded mb-3" style="max-height: 300px; object-fit: cover; width: 100%;">
                            }
                            else
                            {
                                <img src="/images/default-product.jpg" alt="Default Image" class="img-fluid rounded mb-3" style="max-height: 300px; object-fit: cover; width: 100%;">
                            }

                            <!-- Additional Images (if any) -->
                           

                        <!-- Product Details Section -->
                        <div class="col-md-6">
                            <h4 class="card-title" style="font-size: 1.25rem; color: #333;">@Model.Name</h4>
                            <p class="card-text text-muted mb-2" style="font-size: 0.9rem;"><strong>Price:</strong> $@Model.Price</p>
                            <p class="card-text" style="font-size: 0.9rem;"><strong>Description:</strong> @Model.Description</p>
                        </div>
                    </div>
                </div>

                <!-- Back to List Button -->
                <div class="card-footer bg-transparent border-0 text-center">
                    <a asp-action="Index" class="btn btn-outline-primary px-4 custom-btn">Back to List</a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Custom CSS for styling -->
<style>
    /* Gradient Background */
    body {
        background: linear-gradient(to right, #a1c4fd, #c2e9fb);
        min-height: 100vh;
    }

    /* Card Styling */
    .card {
        border: none;
        border-radius: 10px;
        background-color: #fff;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
        }

    .card-body {
        padding: 2rem;
    }

    .card-title {
        font-weight: 600;
    }

    .card-text {
        margin-bottom: 0.5rem;
    }

    /* Button Styling */
    .custom-btn {
        min-width: 80px;
        font-size: 0.9rem;
        border-radius: 5px;
        transition: background-color 0.3s, color 0.3s;
    }

    .btn-outline-primary {
        border-color: #007bff;
        color: #007bff;
    }
    
        .btn-outline-primary:hover {
            background-color: #007bff;
            color: white;
        }

    .gap-2 {
        gap: 0.5rem;
    }
</style>