@model buoi2.Models.Product
@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<div class="container py-5">
    <div class="row">
        <!-- Product Images Section -->
        <div class="col-lg-6 mb-4">
            <div class="bg-white rounded shadow p-4">
                <div class="text-center mb-3">
                    @{
                        string mainImageUrl = "/images/OIP.jpg";
                        if (Model.Images != null && Model.Images.Any() && !string.IsNullOrEmpty(Model.Images.First().Url))
                        {
                            mainImageUrl = Model.Images.First().Url;
                        }
                        else if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            mainImageUrl = Model.ImageUrl;
                        }
                    }

                    <img src="@mainImageUrl" alt="@Model.Name"
                         class="main-product-image img-fluid rounded"
                         style="max-height:400px;object-fit:contain;" id="mainImage"
                         onerror="this.src='/images/OIP.jpg';">
                </div>
                <div class="d-flex justify-content-center gap-2">
                    @if (Model.Images != null && Model.Images.Any())
                    {
                        @foreach (var image in Model.Images.Take(4))
                        {
                            if (!string.IsNullOrEmpty(image.Url))
                            {
                                <img src="@image.Url" alt="@Model.Name thumbnail"
                                     class="img-thumbnail thumbnail-image"
                                     style="width:60px;height:60px;object-fit:cover;"
                                     onclick="changeMainImage('@image.Url')"
                                     onerror="this.style.display='none';">
                            }
                        }
                    }
                    else if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        @for (int i = 0; i < 4; i++)
                        {
                            <img src="@Model.ImageUrl" alt="@Model.Name thumbnail @(i+1)"
                                 class="img-thumbnail thumbnail-image"
                                 style="width:60px;height:60px;object-fit:cover;"
                                 onclick="changeMainImage('@Model.ImageUrl')"
                                 onerror="this.style.display='none';">
                        }
                    }
                    else
                    {
                        @for (int i = 0; i < 4; i++)
                        {
                            <img src="/images/OIP.jpg" alt="Default thumbnail @(i+1)"
                                 class="img-thumbnail thumbnail-image"
                                 style="width:60px;height:60px;object-fit:cover;"
                                 onclick="changeMainImage('/images/OIP.jpg')">
                        }
                    }
                </div>
            </div>
        </div>

        <!-- Product Information Section -->
        <div class="col-lg-6 mb-4">
            <div class="bg-white rounded shadow p-4 h-100 d-flex flex-column">
                <h1 class="mb-2">@Model.Name</h1>
                <div class="text-muted mb-2">Mã sản phẩm: SP@Model.Id</div>
                <div class="mb-3">
                    <span class="fs-3 fw-bold text-danger">@Model.Price.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))</span>
                </div>
                <div class="mb-3">
                    <label class="form-label">Chọn size:</label>
                    <div>
                        <button class="btn btn-outline-primary me-2 size-btn" data-size="M">M</button>
                        <button class="btn btn-outline-primary me-2 size-btn active" data-size="L">L</button>
                        <button class="btn btn-outline-primary size-btn" data-size="XL">XL</button>
                    </div>
                </div>
                <div class="mb-4 d-flex gap-2">
                    <button class="btn btn-outline-dark flex-fill add-to-cart-btn">
                        <i class="fas fa-shopping-cart me-2"></i>Thêm vào giỏ
                    </button>
                    <button class="btn btn-dark flex-fill buy-now-btn">Mua ngay</button>
                </div>
                <div>
                    <h5>Mô tả sản phẩm:</h5>
                    <p>@Model.Description</p>
                </div>
                <div class="mt-3 d-flex gap-3 align-items-center">
                    <img src="/images/toei-animation-logo.png" alt="Toei Animation" style="height:32px;">
                    <img src="/images/dragon-ball-z-logo.png" alt="Dragon Ball Z" style="height:32px;">
                    <img src="/images/dirtycoins-logo.png" alt="DirtyCoins" style="height:32px;">
                </div>
            </div>
        </div>
    </div>

    <!-- Reviews Section -->
    <div class="row mt-5">
        <div class="col-lg-8 mx-auto">
            <div class="card shadow">
                <div class="card-body">
                    <h4 class="mb-3">Đánh giá sản phẩm</h4>
                    @if (ViewBag.AverageRating > 0)
                    {
                        <p class="text-warning mb-2" style="font-size:1.1rem;">
                            <strong>Điểm trung bình:</strong> @(((double)ViewBag.AverageRating).ToString("0.0")) ★
                        </p>
                    }
                    else
                    {
                        <p class="text-muted mb-2"><em>Chưa có đánh giá nào</em></p>
                    }

                    @if (ViewBag.Reviews != null && ViewBag.Reviews.Count > 0)
                    {
                        <ul class="list-group mb-3">
                            @foreach (var review in ViewBag.Reviews)
                            {
                                <li class="list-group-item">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <strong>Rating: @review.Rating ⭐</strong>
                                            <span class="text-muted ms-2">@review.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                                        </div>
                                        @if (User.Identity.IsAuthenticated && review.UserName == User.Identity.Name)
                                        {
                                            <form asp-action="DeleteReview" asp-route-id="@review.Id" method="post" class="m-0 p-0">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Bạn chắc chắn muốn xóa đánh giá này?');">
                                                    Xóa
                                                </button>
                                            </form>
                                        }
                                    </div>
                                    <p class="mt-2 mb-0">@review.Comment</p>
                                    <small class="text-muted">By @review.UserName</small>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p>Chưa có đánh giá nào.</p>
                    }

                    @if (User.Identity.IsAuthenticated)
                    {
                        <h6 class="mt-4">Thêm đánh giá của bạn:</h6>
                        <form asp-action="AddReview" method="post">
                            <input type="hidden" name="productId" value="@Model.Id" />
                            <div class="mb-2">
                                <label for="rating">Điểm (1-5):</label>
                                <select id="rating" name="rating" class="form-select" required>
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <option value="@i">@i</option>
                                    }
                                </select>
                            </div>
                            <div class="mb-2">
                                <label for="content">Nội dung:</label>
                                <textarea id="content" name="comment" class="form-control" required></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary mt-2">Gửi đánh giá</button>
                        </form>
                    }
                    else
                    {
                        <p class="text-muted mt-3">
                            Bạn cần <a href="/Identity/Account/Login">Đăng nhập</a> để viết đánh giá.
                        </p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .main-product-image {
        max-width: 100%;
        max-height: 400px;
        object-fit: contain;
        border-radius: 8px;
    }

    .img-thumbnail {
        border: 2px solid #eee;
        border-radius: 8px;
        cursor: pointer;
        transition: border 0.2s;
    }

        .img-thumbnail:hover {
            border: 2px solid #007bff;
        }

    .thumbnail-image.active {
        border: 2px solid #007bff !important;
    }

    .size-btn.active, .size-btn:active {
        background: #007bff;
        color: #fff;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Size selection
        document.querySelectorAll('.size-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                document.querySelectorAll('.size-btn').forEach(b => b.classList.remove('active'));
                this.classList.add('active');
            });
        });

        // Set first thumbnail as active
        const firstThumbnail = document.querySelector('.thumbnail-image');
        if (firstThumbnail) {
            firstThumbnail.classList.add('active');
        }
    });

    function changeMainImage(imageUrl) {
        // Change main image
        document.getElementById('mainImage').src = imageUrl;

        // Update active thumbnail
        document.querySelectorAll('.thumbnail-image').forEach(thumb => {
            thumb.classList.remove('active');
        });

        // Add active class to clicked thumbnail
        event.target.classList.add('active');
    }
</script>

@section Scripts {
    <script>
        function showAlert(message, type = 'success') {
            const alertDiv = document.createElement('div');
            alertDiv.className = `alert alert-${type} alert-dismissible fade show position-fixed top-0 end-0 m-4`;
            alertDiv.style.zIndex = 9999;
            alertDiv.innerHTML = `<span>${message}</span><button type='button' class='btn-close' data-bs-dismiss='alert'></button>`;
            document.body.appendChild(alertDiv);
            setTimeout(() => { $(alertDiv).fadeOut('slow', () => alertDiv.remove()); }, 3000);
        }
        $(document).ready(function () {
            const productId = @Model.Id;
            $('.add-to-cart-btn').click(function () {
                $.ajax({
                    url: '/ShoppingCart/AddToCart',
                    type: 'POST',
                    data: { productId: productId, quantity: 1 },
                    success: function (res) {
                        showAlert('Đã thêm sản phẩm vào giỏ hàng!');
                        // Cập nhật badge nếu có
                        if (window.updateCartBadge) window.updateCartBadge();
                    },
                    error: function () {
                        showAlert('Có lỗi khi thêm vào giỏ hàng!', 'danger');
                    }
                });
            });
            $('.buy-now-btn').click(function () {
                $.ajax({
                    url: '/ShoppingCart/AddToCart',
                    type: 'POST',
                    data: { productId: productId, quantity: 1 },
                    success: function () {
                        window.location.href = '/ShoppingCart/Checkout';
                    },
                    error: function () {
                        showAlert('Có lỗi khi mua ngay!', 'danger');
                    }
                });
            });
        });
    </script>
}
