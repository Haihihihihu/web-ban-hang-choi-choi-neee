@model IEnumerable<buoi2.Models.Product>
@{
    ViewData["Title"] = "Index";
    string currentSearch = ViewBag.SearchName as string ?? "";
    string currentSort = ViewBag.SortBy as string ?? "";
    int? currentCategory = ViewBag.CategoryId as int?;
    int numOfQuantity = 1;
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<style>
    body {
        background-color: #ffffff;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .shop-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 20px;
        background-color: #ffffff;
    }

    .shop-header {
        text-align: center;
        margin-bottom: 40px;
        padding: 20px 0;
        border-bottom: 1px solid #e8e8e8;
    }

    .shop-title {
        font-size: 2.5rem;
        font-weight: 300;
        color: #333;
        margin: 0;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    .search-filter-section {
        background-color: #f8f9fa;
        padding: 25px;
        border-radius: 0;
        margin-bottom: 40px;
        border: 1px solid #e9ecef;
    }

    .search-input {
        height: 45px;
        border: 1px solid #ddd;
        border-radius: 0;
        font-size: 14px;
        padding: 0 15px;
        background-color: #ffffff;
    }

        .search-input:focus {
            border-color: #333;
            box-shadow: none;
            outline: none;
        }

    .filter-select {
        height: 45px;
        border: 1px solid #ddd;
        border-radius: 0;
        font-size: 14px;
        padding: 0 15px;
        background-color: #ffffff;
    }

        .filter-select:focus {
            border-color: #333;
            box-shadow: none;
            outline: none;
        }

    .search-btn {
        height: 45px;
        background-color: #333;
        border: none;
        color: white;
        font-size: 14px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 1px;
        border-radius: 0;
        transition: background-color 0.3s ease;
    }

        .search-btn:hover {
            background-color: #000;
        }

    .products-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 30px;
        margin-bottom: 50px;
    }

    .product-card {
        background-color: #ffffff;
        border: 1px solid #e8e8e8;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

        .product-card:hover {
            box-shadow: 0 8px 25px rgba(0,0,0,0.1);
            transform: translateY(-2px);
        }

    .product-image-container {
        position: relative;
        width: 100%;
        height: 350px;
        overflow: hidden;
        background-color: #f8f9fa;
    }

    .product-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .product-card:hover .product-image {
        transform: scale(1.05);
    }

    .new-arrival-badge {
        position: absolute;
        top: 10px;
        left: 10px;
        background-color: #333;
        color: white;
        padding: 5px 12px;
        font-size: 11px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .product-info {
        padding: 20px;
        text-align: center;
    }

    .product-name {
        font-size: 14px;
        font-weight: 400;
        color: #333;
        margin: 0 0 8px 0;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        line-height: 1.4;
    }

    .product-description {
        font-size: 13px;
        color: #666;
        margin: 0 0 12px 0;
        line-height: 1.4;
        height: 35px;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    .product-price {
        font-size: 16px;
        color: #333;
        font-weight: 600;
        margin: 0 0 20px 0;
    }

    .product-actions {
        display: flex;
        justify-content: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .action-btn {
        padding: 8px 16px;
        font-size: 12px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border: 1px solid #333;
        background-color: transparent;
        color: #333;
        text-decoration: none;
        transition: all 0.3s ease;
        min-width: 70px;
    }

        .action-btn:hover {
            background-color: #333;
            color: white;
            text-decoration: none;
        }

        .action-btn.btn-view {
            border-color: #007bff;
            color: #007bff;
        }

            .action-btn.btn-view:hover {
                background-color: #007bff;
                color: white;
            }

        .action-btn.btn-edit {
            border-color: #28a745;
            color: #28a745;
        }

            .action-btn.btn-edit:hover {
                background-color: #28a745;
                color: white;
            }

        .action-btn.btn-delete {
            border-color: #dc3545;
            color: #dc3545;
        }

            .action-btn.btn-delete:hover {
                background-color: #dc3545;
                color: white;
            }

        .action-btn.btn-cart {
            border-color: #ffc107;
            color: #ffc107;
        }

            .action-btn.btn-cart:hover {
                background-color: #ffc107;
                color: #333;
            }

        .action-btn.btn-wishlist {
            border-color: #dc3545;
            color: #dc3545;
        }

            .action-btn.btn-wishlist:hover {
                background-color: #dc3545;
                color: white;
            }

            .action-btn.btn-wishlist.active {
                background-color: #dc3545;
                color: white;
            }

        .action-btn.btn-cart.added {
            background-color: #28a745;
            border-color: #28a745;
            color: white;
        }

    .no-products {
        text-align: center;
        padding: 60px 20px;
        color: #666;
        font-size: 18px;
    }

    .rating-display {
        font-size: 0.9rem;
        color: #ffc107;
        margin-bottom: 8px;
    }

    .rating-text {
        font-size: 0.8rem;
        color: #666;
    }

    .form-label {
        margin-bottom: 8px;
        display: block;
    }

    .row {
        margin-left: -15px;
        margin-right: -15px;
    }

    .col-md-6, .col-md-4, .col-md-2 {
        padding-left: 15px;
        padding-right: 15px;
    }

    .mb-3 {
        margin-bottom: 1rem;
    }

    .mb-md-0 {
        margin-bottom: 0;
    }

    .align-items-end {
        align-items: flex-end;
    }

    .w-100 {
        width: 100%;
    }

    .form-control, .form-select {
        width: 100%;
        box-sizing: border-box;
    }
</style>

<div class="shop-container">
    <div class="shop-header">
        <h1 class="shop-title">FootBall Store</h1>
    </div>

    <!-- Search & Filter Section -->
    <form method="get" asp-action="Index" class="search-filter-section">
        <div class="row align-items-end">
            <div class="col-md-6 mb-3 mb-md-0">
                <label class="form-label text-muted text-uppercase" style="font-size: 12px; font-weight: 500; letter-spacing: 1px;">Search Products</label>
                <input type="text" name="searchName" value="@currentSearch" class="form-control search-input" placeholder="Enter product name..." />
            </div>
            <div class="col-md-4 mb-3 mb-md-0">
                <label class="form-label text-muted text-uppercase" style="font-size: 12px; font-weight: 500; letter-spacing: 1px;">Sort By Price</label>
                <select name="sortBy" class="form-select filter-select">
                    <option value="">-- Default --</option>
                    <option value="price_asc" selected="@(currentSort == "price_asc")">Giá Tăng Dần</option>
                    <option value="price_desc" selected="@(currentSort == "price_desc")">Giá Giảm Dần</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn search-btn w-100">Search</button>
            </div>
        </div>
    </form>

    <!-- Products Grid -->
    @if (Model != null && Model.Any())
    {
        <div class="products-grid">
            @foreach (var item in Model)
            {
                <div class="product-card">
                    <div class="product-image-container">
                        @{
                            string productImageUrl = "/images/OIP.jpg";
                            if (item.Images != null && item.Images.Any() && !string.IsNullOrEmpty(item.Images.First().Url))
                            {
                                productImageUrl = item.Images.First().Url;
                            }
                            else if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                productImageUrl = item.ImageUrl;
                            }
                        }
                        <img src="@productImageUrl" class="product-image" alt="@item.Name" onerror="this.src='/images/OIP.jpg';">
                        <div class="new-arrival-badge">Hot</div>
                    </div>
                    <div class="product-info">
                        <h3 class="product-name">@item.Name</h3>
                        <p class="product-description">@item.Description</p>

                       

                        <div class="product-price">$@item.Price</div>
                        <div class="product-actions">
                            <a asp-action="Display" asp-route-id="@item.Id" class="action-btn btn-view">View</a>

                            @if (!User.IsInRole("Admin"))
                            {
                                <button type="button" class="action-btn btn-cart add-to-cart-btn" data-product-id="@item.Id" title="Thêm vào giỏ hàng">
                                    <i class="fas fa-cart-plus"></i> Cart
                                </button>
                                <button type="button" class="action-btn btn-wishlist add-to-wishlist-btn" data-product-id="@item.Id" title="Thêm vào danh sách yêu thích">
                                    <i class="fas fa-heart"></i>
                                </button>
                            }
                            else
                            {
                                <a asp-action="Update" asp-route-id="@item.Id" class="action-btn btn-edit">Edit</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="action-btn btn-delete" onclick="return confirm('Are you sure you want to delete this product?');">Delete</a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="no-products">
            <i class="fas fa-search mb-3" style="font-size: 48px; color: #ccc;"></i>
            <p>No products found matching your criteria.</p>
        </div>
    }
</div>

@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@Html.AntiForgeryToken()

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const token = '@Antiforgery.GetAndStoreTokens(Context).RequestToken';

        // Wishlist functionality
        document.querySelectorAll(".add-to-wishlist-btn").forEach(btn => {
            btn.addEventListener("click", function () {
                const productId = this.dataset.productId;
                fetch('@Url.Action("Add", "Wishlist")?productId=' + productId, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token }
                })
                    .then(res => {
                        if (res.ok) {
                            this.classList.toggle('active');
                            const icon = this.querySelector('i');
                            if (this.classList.contains('active')) {
                                this.title = "Đã thêm vào danh sách yêu thích";
                            } else {
                                this.title = "Thêm vào danh sách yêu thích";
                            }
                        } else {
                            alert("Thêm vào danh sách yêu thích thất bại.");
                        }
                    })
                    .catch(() => alert("Có lỗi mạng. Vui lòng thử lại."));
            });
        });

        // Cart functionality
        document.querySelectorAll(".add-to-cart-btn").forEach(btn => {
            btn.addEventListener("click", async function () {
                const productId = this.dataset.productId;
                try {
                    const response = await fetch('@Url.Action("AddToCart", "ShoppingCart")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'RequestVerificationToken': token
                        },
                        body: new URLSearchParams({ productId: productId, quantity: 1 })
                    });

                    const data = await response.json();

                    if (data.success) {
                        this.innerHTML = '<i class="fas fa-check"></i> Added';
                        this.classList.add('added');
                        this.disabled = true;
                        this.title = "Đã thêm vào giỏ hàng";
                        // Cập nhật badge cart
                        fetch('/ShoppingCart/GetCartCount')
                          .then(res => res.json())
                          .then(data => {
                              document.getElementById('cart-count').innerText = data.count;
                          });
                    } else {
                        alert(data.message || "Không thể thêm vào giỏ hàng.");
                    }
                } catch (error) {
                    console.error(error);
                    alert("Có lỗi mạng. Vui lòng thử lại.");
                }
            });
        });
    });
</script>