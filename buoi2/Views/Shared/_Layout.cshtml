<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - buoi2</title>
    @RenderSection("Styles", required: false)

    <!-- Bootstrap 5 & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/buoi2.styles.css" asp-append-version="true" />
    @section Styles {
        <link rel="stylesheet" href="~/css/inventory.css" />
    }


    <!-- jQuery & Validation -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
</head>
<body>
    <!-- HEADER / NAVBAR -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm mb-3">
            <div class="container">
                <a class="navbar-brand fw-bold text-primary d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-cart-fill fs-4"></i>
                    <span>FOOTBALL STORE</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0">

                        @if (!User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link active text-primary" asp-controller="Home" asp-action="Index">Trang Chủ</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Privacy">Chính Sách</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Product" asp-action="Index">Sản Phẩm</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Contact">Liên Hệ</a>
                            </li>
                            <!-- Dark Mode Toggle -->
                            <li class="nav-item d-flex align-items-center">
                                <div class="form-check form-switch me-3">
                                    <input class="form-check-input" type="checkbox" id="darkModeSwitch">
                                    <label class="form-check-label" for="darkModeSwitch">
                                        <i class="bi bi-moon" id="darkModeIcon"></i>
                                    </label>
                                </div>
                            </li>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a href="/Admin/ProductManager/Index">Trang Admin</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="Admin" asp-controller="ProductManager" asp-action="add">+ Sản Phẩm</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="Admin" asp-controller="CategoryManager" asp-action="add">+ Danh Mục</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="Admin" asp-controller="InventoryManager" asp-action="Add">QL Tồn Kho</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="Admin" asp-controller="UserManager" asp-action="index">QL Người dùng</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="Admin" asp-controller="OrderManager" asp-action="add">QL Đơn Hàng</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="Admin" asp-controller="AnalyticAdmin" asp-action="index">Thống Kê</a>
                            </li>
                            <li class="nav-item">
                                <a href="/home/index">Trang Chủ</a>
                            </li>
                        }
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        <partial name="_LoginPartial" />
                    </div>
                    @if (!User.IsInRole("Admin"))
                    {
                        <div class="d-flex align-items-center gap-2">
                            <a asp-controller="Wishlist" asp-action="Index" class="btn btn-outline-danger">
                                <i class="fas fa-heart"></i> Wishlist
                            </a>
                            <a asp-controller="ShoppingCart" asp-action="Index" class="btn btn-outline-dark position-relative">
                                🛒 Cart
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" id="cart-count">0</span>
                            </a>
                        </div>
                    }



                </div>
            </div>
        </nav>
    </header>

    <!-- DARK MODE CUSTOM CSS -->
    <style>
        /* Dark Mode Styles */
        body.dark-mode {
            background-color: #121212;
            color: #f1f1f1;
            transition: background-color 0.3s ease, color 0.3s ease;
        }

            body.dark-mode nav.navbar {
                background-color: #1e1e1e !important;
                border-bottom: 1px solid #333;
            }

            body.dark-mode .navbar-brand {
                color: #00d4ff !important;
            }

            body.dark-mode .nav-link {
                color: #cccccc !important;
            }

                body.dark-mode .nav-link:hover {
                    color: #ffffff !important;
                }

                body.dark-mode .nav-link.active {
                    color: #00d4ff !important;
                }

            body.dark-mode .form-check-label i {
                color: #f1c40f;
            }

            body.dark-mode footer {
                background-color: #1a1a1a !important;
            }

                body.dark-mode footer p,
                body.dark-mode footer small,
                body.dark-mode footer h5 {
                    color: #cccccc;
                }

            body.dark-mode .card {
                background-color: #2a2a2a;
                color: #e0e0e0;
                border-color: #444;
            }

            body.dark-mode .btn-outline-dark {
                border-color: #cccccc;
                color: #ffffff;
            }

                body.dark-mode .btn-outline-dark:hover {
                    background-color: #444;
                    border-color: #cccccc;
                }

            body.dark-mode .btn-outline-danger {
                border-color: #ff4d4d;
                color: #ff4d4d;
            }

                body.dark-mode .btn-outline-danger:hover {
                    background-color: #ff4d4d;
                    color: white;
                }

            body.dark-mode .badge.bg-danger {
                background-color: #ff4d4d !important;
            }

            body.dark-mode .text-warning {
                color: #ffc107 !important;
            }

            /* Dark mode for main content area */
            body.dark-mode .container-fluid,
            body.dark-mode main {
                background-color: #121212;
                color: #f1f1f1;
            }

            /* Dark mode for sections and divs */
            body.dark-mode section,
            body.dark-mode .row,
            body.dark-mode .col,
            body.dark-mode .col-md-6,
            body.dark-mode .text-center {
                background-color: transparent;
                color: #f1f1f1;
            }

            /* Dark mode for headings */
            body.dark-mode h1,
            body.dark-mode h2,
            body.dark-mode h3,
            body.dark-mode h4,
            body.dark-mode h5,
            body.dark-mode h6 {
                color: #f1f1f1;
            }

            /* Dark mode for images and links */
            body.dark-mode img {
                opacity: 0.9;
            }

            body.dark-mode a {
                color: #00d4ff;
            }

                body.dark-mode a:hover {
                    color: #ffffff;
                }

            /* Dark mode for buttons */
            body.dark-mode .btn {
                border-color: #555;
            }

            body.dark-mode .btn-primary {
                background-color: #0d6efd;
                border-color: #0d6efd;
            }

            body.dark-mode .btn-secondary {
                background-color: #6c757d;
                border-color: #6c757d;
            }

            /* Dark mode for specific content areas */
            body.dark-mode .category-section,
            body.dark-mode .product-grid,
            body.dark-mode .category-item {
                background-color: transparent;
            }

        /* Smooth transitions */
        body {
            transition: background-color 0.3s ease, color 0.3s ease;
        }

        .navbar {
            transition: background-color 0.3s ease;
        }

        .card {
            transition: background-color 0.3s ease, color 0.3s ease;
        }

        /* Dark mode switch styling */
        .form-check-input:checked {
            background-color: #0d6efd;
            border-color: #0d6efd;
        }

        #darkModeIcon {
            transition: transform 0.3s ease;
        }

        body.dark-mode #darkModeIcon {
            transform: rotate(180deg);
        }
    </style>

    <!-- MAIN CONTENT -->
    <div class="container-fluid p-0">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- FOOTER -->
    <footer class="bg-dark text-light mt-5 pt-4 pb-3">
        <div class="container">
            <div class="row">
                <!-- Chi nhánh -->
                <div class="col-md-4 mb-3">
                    <h5 class="text-warning">Chi nhánh Khu E</h5>
                    <p>Địa chỉ: 31/36 Ung Văn Khiêm, Bình Thạnh, TP.HCM</p>
                    <p>Hotline: 0901 234 567</p>
                </div>

                <div class="col-md-4 mb-3">
                    <h5 class="text-warning">Chi nhánh Khu A&B</h5>
                    <p>Địa chỉ: 475A Điện Biên Phủ, Bình Thạnh, TP.HCM</p>
                    <p>Hotline: 0902 345 678</p>
                </div>

                <div class="col-md-4 mb-3">
                    <h5 class="text-warning">Chi nhánh Khu U</h5>
                    <p>Địa chỉ: 80/86 D2 (Nguyễn Gia Trí), Bình Thạnh, TP.HCM</p>
                    <p>Hotline: 0903 456 789</p>
                </div>
            </div>

            <div class="text-center mt-4">
                <small>© 2025 Web Bán Hàng. All rights reserved.</small>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Dark Mode Script -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const darkModeSwitch = document.getElementById('darkModeSwitch');
            const darkModeIcon = document.getElementById('darkModeIcon');

            // Check for saved dark mode preference or default to light mode
            const currentTheme = localStorage.getItem('theme') || 'light';

            if (currentTheme === 'dark') {
                document.body.classList.add('dark-mode');
                if (darkModeSwitch) darkModeSwitch.checked = true;
                if (darkModeIcon) darkModeIcon.classList.replace('bi-moon', 'bi-sun');
            }

            // Dark mode toggle functionality
            if (darkModeSwitch) {
                darkModeSwitch.addEventListener('change', function () {
                    if (this.checked) {
                        document.body.classList.add('dark-mode');
                        localStorage.setItem('theme', 'dark');
                        if (darkModeIcon) darkModeIcon.classList.replace('bi-moon', 'bi-sun');
                    } else {
                        document.body.classList.remove('dark-mode');
                        localStorage.setItem('theme', 'light');
                        if (darkModeIcon) darkModeIcon.classList.replace('bi-sun', 'bi-moon');
                    }
                });
            }

            // Chỉ cập nhật cart badge nếu không phải admin
            if (!document.body.innerHTML.includes('Trang Admin')) {
                fetch('/ShoppingCart/GetCartCount')
                    .then(res => res.json())
                    .then(data => {
                        var badge = document.getElementById('cart-count');
                        if (badge) badge.innerText = data.count;
                    })
                    .catch(err => console.log('Error loading cart count:', err));
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>