@model buoi2.Models.Order
@{
    ViewData["Title"] = "Checkout";
    var cart = ViewBag.Cart as buoi2.Models.ShoppingCart;
}
<div class="container mt-4">
    <h3 class="mb-4">Sản phẩm trong giỏ hàng</h3>
    <table class="table table-bordered">
        <thead class="table-light">
            <tr>
                <th>Sản phẩm</th>
                <th>Số lượng</th>
                <th>Giá</th>
                <th>Thành tiền</th>
            </tr>
        </thead>
        <tbody>
            @if (cart != null && cart.Items.Any())
            {
                foreach (var item in cart.Items)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@item.Quantity</td>
                        <td>@item.Price.ToString("N0")</td>
                        <td>@((item.Quantity * item.Price).ToString("N0"))</td>
                    </tr>
                }
            }
        </tbody>
        <tfoot>
            <tr style="background: #d4f6ff;">
                <td colspan="3" class="fw-bold">Tổng tiền:</td>
                <td class="fw-bold">@((cart?.Items.Sum(i => i.Quantity * i.Price) ?? 0).ToString("N0")) VNĐ</td>
            </tr>
        </tfoot>
    </table>

    <div class="row justify-content-center mt-5">
        <div class="col-md-8">
            <h2 class="text-center mb-4">THÔNG TIN ĐẶT HÀNG</h2>
            <form asp-action="Checkout" method="post">
                <div class="mb-3">
                    <label class="form-label fw-bold">ĐỊA CHỈ GIAO HÀNG</label>
                    <input asp-for="ShippingAddress" class="form-control" placeholder="Nhập địa chỉ giao hàng của bạn..." />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">GHI CHÚ</label>
                    <textarea asp-for="Notes" class="form-control" placeholder="Nếu cần gì hãy để lại ghi chú..."></textarea>
                </div>
                <div class="text-center mt-4">
                    <button type="submit" class="btn btn-dark btn-lg px-5">Đặt Hàng</button>
                </div>
            </form>
        </div>
    </div>
</div>
