@model Order

<style>
    .checkout-container {
        max-width: 800px;
        margin: 0 auto;
        padding: 40px 20px;
        background-color: #ffffff;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .checkout-header {
        text-align: center;
        margin-bottom: 50px;
        padding-bottom: 20px;
        border-bottom: 1px solid #e8e8e8;
    }

    .checkout-title {
        font-size: 2.2rem;
        font-weight: 300;
        color: #333;
        margin: 0;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    .checkout-form {
        background-color: #ffffff;
        border: 1px solid #e8e8e8;
        padding: 40px;
        margin-bottom: 40px;
    }

    .form-group {
        margin-bottom: 30px;
    }

    .form-label {
        display: block;
        color: #333;
        font-weight: 500;
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 10px;
    }

    .form-control {
        width: 100%;
        padding: 15px;
        border: 1px solid #ddd;
        border-radius: 0;
        font-size: 14px;
        color: #333;
        background-color: #ffffff;
        transition: border-color 0.3s ease;
        font-family: inherit;
    }

    .form-control:focus {
        outline: none;
        border-color: #333;
        box-shadow: none;
    }

    .form-control::placeholder {
        color: #999;
        font-style: italic;
    }

    textarea.form-control {
        min-height: 100px;
        resize: vertical;
    }

    .submit-section {
        text-align: center;
        padding: 30px 0;
        border-top: 1px solid #e8e8e8;
        margin-top: 20px;
    }

    .submit-btn {
        background-color: #333;
        border: none;
        color: white;
        padding: 15px 40px;
        font-size: 14px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 1px;
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-block;
    }

    .submit-btn:hover {
        background-color: #000;
        transform: translateY(-2px);
    }

    .submit-btn:active {
        transform: translateY(0);
    }

    .form-row {
        display: flex;
        gap: 20px;
        margin-bottom: 30px;
    }

    .form-col {
        flex: 1;
    }

    
</style>

<div class="checkout-container">
    <div class="checkout-header">
        <h2 class="checkout-title">Checkout</h2>
    </div>

    <form asp-action="Checkout" method="post" class="checkout-form">
        <div class="form-group">
            <label asp-for="ShippingAddress" class="form-label">Shipping Address</label>
            <input asp-for="ShippingAddress" class="form-control" placeholder="Enter your shipping address..." />
        </div>

        <div class="form-group">
            <label asp-for="Notes" class="form-label">Notes</label>
            <textarea asp-for="Notes" class="form-control" placeholder="Any special instructions or notes..."></textarea>
        </div>

        <div class="submit-section">
            <button type="submit" class="submit-btn">Place Order</button>
        </div>
    </form>
</div>
﻿@model buoi2.Models.Order
@{
    // Lấy giỏ hàng từ ViewBag thay vì HttpContext trực tiếp
    var cart = ViewBag.Cart as buoi2.Models.ShoppingCart ?? new buoi2.Models.ShoppingCart();
}

<h2>Thanh toán</h2>

<!-- Hiển thị thông báo lỗi từ form hoặc server -->
@if (ViewData.ModelState.Any(x => x.Value.Errors.Any()))
{
    <div class="alert alert-danger">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <p>@error.ErrorMessage</p>
        }
    </div>
}

<!-- Hiển thị danh sách sản phẩm trong giỏ hàng -->
@if (cart.Items.Any())
{
    <div class="card mb-3">
        <div class="card-header">
            <h5>Sản phẩm trong giỏ hàng</h5>
        </div>
        <div class="card-body">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Sản phẩm</th>
                        <th>Số lượng</th>
                        <th>Giá</th>
                        <th>Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in cart.Items)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>@item.Quantity</td>
                            <td>@item.Price.ToString("N0", new System.Globalization.CultureInfo("vi-VN"))</td>
                            <td>@item.SubTotal.ToString("N0", new System.Globalization.CultureInfo("vi-VN"))</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="table-info">
                        <th colspan="3">Tổng tiền:</th>
                        <th>@cart.GetTotal().ToString("N0", new System.Globalization.CultureInfo("vi-VN"))</th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning">Giỏ hàng trống. Vui lòng thêm sản phẩm trước khi thanh toán.</div>
}

<!-- Form thanh toán -->
<form asp-action="Checkout" method="post">
    @Html.AntiForgeryToken()
    <div class="form-group mb-3">
        <label asp-for="ShippingAddress">Địa chỉ giao hàng</label>
        <input asp-for="ShippingAddress" class="form-control" />
        <span asp-validation-for="ShippingAddress" class="text-danger"></span>
    </div>
    <div class="form-group mb-3">
        <label asp-for="Notes">Ghi chú</label>
        <textarea asp-for="Notes" class="form-control"></textarea>
        <span asp-validation-for="Notes" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary" @(cart.Items.Any() ? "" : "disabled")>Đặt hàng</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<script>
    document.querySelector('form').addEventListener('submit', function(e) {
        let valid = true;
        document.querySelectorAll('td').forEach(td => {
            if (td.innerText.trim() === "0") {
                valid = false;
            }
        });
        if(!valid) {
            alert("Vui lòng loại bỏ sản phẩm có số lượng 0 trước khi thanh toán.");
            e.preventDefault();
        }
    });
</script>
