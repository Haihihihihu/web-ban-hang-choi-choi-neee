@model buoi2.Models.Order

@{
    decimal subtotal = Model.OrderDetails.Sum(item => item.Price * item.Quantity);
}

<h3>Chi tiết đơn hàng</h3>
<p><strong>Mã đơn:</strong> #@Model.Id</p>
<p><strong>Ngày đặt:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
<p><strong>Địa chỉ:</strong> @Model.ShippingAddress</p>

<table class="table">
    <thead>
        <tr>
            <th>Sản phẩm</th>
            <th>Số lượng</th>
            <th>Giá</th>
            <th>Thành tiền</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.OrderDetails)
        {
            <tr>
                <td>@item.Product?.Name</td>
                <td>@item.Quantity</td>
                <td>@item.Price.ToString("N0") ₫</td>
                <td>@((item.Price * item.Quantity).ToString("N0")) ₫</td>
            </tr>
        }
    </tbody>
</table>

<p><strong>Tổng tạm tính:</strong> @subtotal.ToString("N0") ₫</p>
@if (subtotal > Model.TotalPrice)
{
    <p><strong>Voucher giảm:</strong> - @((subtotal - Model.TotalPrice).ToString("N0")) ₫</p>
}
<p><strong>Tổng thanh toán:</strong> @Model.TotalPrice.ToString("N0") ₫</p>
