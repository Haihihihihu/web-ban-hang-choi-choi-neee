@model buoi2.Models.Order
@using buoi2.Models 

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-success text-white text-center">
                    <h3><i class="fas fa-check-circle"></i> Chi tiết đơn hàng</h3>
                </div>
                <div class="card-body">
                    @if (ViewBag.IsNewOrder == true)
                    {
                        <div class="alert alert-success" role="alert">
                            <h4 class="alert-heading">Cảm ơn bạn đã đặt hàng!</h4>
                            <p>Đơn hàng của bạn đã được xử lý thành công. Chúng tôi sẽ liên hệ với bạn sớm để xác nhận và giao hàng.</p>
                        </div>
                    }

                    <div class="order-details">
                        <h5>Thông tin đơn hàng</h5>
                        <div class="row mb-3">
                            <div class="col-sm-3"><strong>Mã đơn hàng:</strong></div>
                            <div class="col-sm-9">#@Model.Id</div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-sm-3"><strong>Ngày đặt:</strong></div>
                            <div class="col-sm-9">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-sm-3"><strong>Địa chỉ giao hàng:</strong></div>
                            <div class="col-sm-9">@Model.ShippingAddress</div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-sm-3"><strong>Trạng thái:</strong></div>
                            <div class="col-sm-9">
                                @switch (Model.Status)
                                {
                                    case buoi2.Models.Order.OrderStatus.Pending:
                                        <span class="badge bg-secondary">Chờ xác nhận</span>
                                        break;
                                    case buoi2.Models.Order.OrderStatus.Preparing:
                                        <span class="badge bg-warning">Đang chuẩn bị hàng</span>
                                        break;
                                    case buoi2.Models.Order.OrderStatus.Shipping:
                                        <span class="badge bg-primary">Đang giao hàng</span>
                                        break;
                                    case buoi2.Models.Order.OrderStatus.Delivered:
                                        <span class="badge bg-success">Đã giao hàng</span>
                                        break;
                                    case buoi2.Models.Order.OrderStatus.Cancelled:
                                        <span class="badge bg-danger">Đã hủy</span>
                                        break;
                                }
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.Notes))
                        {
                            <div class="row mb-3">
                                <div class="col-sm-3"><strong>Ghi chú:</strong></div>
                                <div class="col-sm-9">@Model.Notes</div>
                            </div>
                        }
                    </div>

                    @if (Model.OrderDetails != null && Model.OrderDetails.Any())
                    {
                        <div class="order-items mt-4">
                            <h5>Chi tiết sản phẩm</h5>
                            <div class="table-responsive">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>Sản phẩm</th>
                                            <th>Giá</th>
                                            <th>Số lượng</th>
                                            <th>Thành tiền</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.OrderDetails)
                                        {
                                            <tr>
                                                <td>@(item.Product?.Name ?? "Sản phẩm không xác định")</td>
                                                <td>@item.Price.ToString("N0", new System.Globalization.CultureInfo("vi-VN"))</td>
                                                <td>@item.Quantity</td>
                                                <td>@((item.Price * item.Quantity).ToString("N0", new System.Globalization.CultureInfo("vi-VN")))</td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr class="table-info">
                                            <th colspan="3">Tổng tiền:</th>
                                            <th>@Model.TotalPrice.ToString("N0", new System.Globalization.CultureInfo("vi-VN"))</th>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">Không có chi tiết đơn hàng.</div>
                    }

                    <div class="text-center mt-4">
                        <a href="@Url.Action("OrderHistory", "ShoppingCart")" class="btn btn-primary">Xem lịch sử đơn hàng</a>
                        <a href="@Url.Action("Index", "Product")" class="btn btn-primary">Tiếp tục mua sắm</a>
                        <a href="@Url.Action("Index", "Home")" class="btn btn-secondary">Về trang chủ</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Tự động ẩn thông báo sau 5 giây
        setTimeout(function () {
            $('.alert').fadeOut('slow');
        }, 5000);
    </script>
}