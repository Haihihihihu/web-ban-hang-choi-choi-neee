@model IEnumerable<buoi2.Models.Order>

<table class="table">
    <thead>
        <tr>
            <th>Mã đơn hàng</th>
            <th>Ngày đặt</th>
            <th>Tổng tiền</th>
            <th>Trạng thái</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>#@order.Id</td>
                <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@order.TotalPrice.ToString("N0")</td>
                <td>
                    @{
                        string labelClass = order.Status switch
                        {
                            buoi2.Models.Order.OrderStatus.Pending => "badge bg-secondary",
                            buoi2.Models.Order.OrderStatus.Preparing => "badge bg-warning text-dark",
                            buoi2.Models.Order.OrderStatus.Shipping => "badge bg-info text-dark",
                            buoi2.Models.Order.OrderStatus.Delivered => "badge bg-success",
                            buoi2.Models.Order.OrderStatus.Cancelled => "badge bg-danger",
                            _ => "badge bg-light"
                        };
                    }
                    <span class="@labelClass">@order.Status.ToString()</span>
                </td>
                <td>
                    <a href="/ShoppingCart/OrderCompleted/@order.Id" class="btn btn-sm btn-primary">Xem chi tiết</a>
                    @if (order.Status == buoi2.Models.Order.OrderStatus.Pending)
                    {
                        <form asp-action="CancelOrder" asp-route-id="@order.Id" method="post" style="display:inline;">
                            <button type="submit" class="btn btn-sm btn-danger">Hủy đơn</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
